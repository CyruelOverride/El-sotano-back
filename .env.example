# Supabase pooler (puerto 6543 = pgbouncer). En Render va como variable de entorno BddString.
BddString="postgresql://USUARIO:CLAVE@HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
PORT=3000
# Orígenes permitidos (coma-separado): el dominio del front
CORS_ORIGIN="http://localhost:5173"
# Credenciales del admin (scripts/create-admin.js)
ADMIN_EMAIL="admin@elsotano.example"
ADMIN_PASSWORD="cambiar-esta-clave"
